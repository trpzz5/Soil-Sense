function runCropAnalysis() {
    const currentPh = parseFloat(document.getElementById('live-ph').textContent);
    const currentMoisture = parseInt(document.getElementById('live-moisture').textContent);

    const matches = cropDatabase.filter(crop => {
        return currentPh >= crop.minPh && 
               currentPh <= crop.maxPh && 
               currentMoisture >= crop.minMoist && 
               currentMoisture <= crop.maxMoist;
    }).slice(0, 5); 

    const container = document.querySelector('#recommendation-screen .page-content');
    
    if (matches.length === 0) {
        container.innerHTML = `
            <div class="no-match" style="text-align:center; padding: 20px;">
                <p style="font-size: 50px;">⚠️</p>
                <p>No crops match these current levels perfectly.</p>
                <button class="primary-btn" onclick="goBack()">Try Again</button>
            </div>`;
    } else {
        addToHistory(matches[0].name, currentPh, currentMoisture + "%");

        let html = `<h3 style="margin-bottom:15px;">Top 5 Recommendations:</h3>`;
        matches.forEach(crop => {
            html += `
                <div class="history-item" style="margin-bottom:12px; border-left: 5px solid #2e7d32; padding-left:10px;">
                    <p><strong>${crop.name}</strong></p>
                    <div style="font-size: 12px; color: #444; line-height: 1.6;">
                        <strong>Ideal pH:</strong> ${crop.minPh}-${crop.maxPh} | 
                        <strong>Moisture:</strong> ${crop.minMoist}-${crop.maxMoist}%<br>
                        <strong>Needed:</strong> N:${crop.n} P:${crop.p} K:${crop.k}
                    </div>
                </div>`;
        });
        html += `<button class="primary-btn" onclick="goBack()" style="margin-top:20px">Back to Dashboard</button>`;
        container.innerHTML = html;
    }
    navigateTo('recommendation-screen');
}

function handleRecommendation() {
    const userInput = document.querySelector('.modal-input').value.trim().toLowerCase();
    const selectedCrop = cropDatabase.find(c => c.name.toLowerCase() === userInput);
    const container = document.querySelector('#recommendation-screen .page-content');
    
    hidePopup(); 

    if (selectedCrop) {
        addToHistory(selectedCrop.name, "Manual Check", "Search");
        container.innerHTML = `
            <h3 style="margin-bottom:15px;">Manual Crop Check:</h3>
            <div class="history-item" style="border-left: 5px solid #ffa500; padding: 15px;">
                <p style="font-size: 18px;"><strong>${selectedCrop.name}</strong></p>
                <hr style="margin: 10px 0; opacity: 0.2;">
                <p><strong>Target pH:</strong> ${selectedCrop.minPh} - ${selectedCrop.maxPh}</p>
                <p><strong>Target Moisture:</strong> ${selectedCrop.minMoist}% - ${selectedCrop.maxMoist}%</p>
                <p><strong>Required N:</strong> ${selectedCrop.n} | <strong>P:</strong> ${selectedCrop.p} | <strong>K:</strong> ${selectedCrop.k}</p>
            </div>
            <button class="primary-btn" onclick="goBack()" style="margin-top:20px">Back</button>`;
    } else {
        container.innerHTML = `<div style="text-align:center; padding: 20px;"><p>❌ Crop "${userInput}" not found.</p><button class="primary-btn" onclick="goBack()">Try Again</button></div>`;
    }
    navigateTo('recommendation-screen');
}

window.onload = () => {
